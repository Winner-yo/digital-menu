# Database
DATABASE_URL="postgresql://postgres:password@127.0.0.1:5432/digital_menu_db"

# Server
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_URL=http://localhost:3000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email (optional for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ethiopian-menu.com

# Payment (mock mode for local dev)
USE_MOCK_PAYMENT=true
PAYMENT_PROVIDER=mock

# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_BASE_URL=https://app.ethiotelecom.et

# CBE Birr
CBE_BIRR_API_KEY=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_BASE_URL=https://api.cbebirr.com

# Chapa
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
