# Database
# Neon gives you ONE connection string. Use it as DATABASE_URL.
# Example from Neon (Connection pooling ON — host contains "-pooler"):
#   postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-bread-ayr2pvtz-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
# Drop "&channel_binding=require" if Neon adds it — Prisma does not need it.
#
# DIRECT_URL is the same string with "-pooler" removed from the host:
#   ...@ep-cool-bread-ayr2pvtz-pooler.c-5.us-east-2...  → DATABASE_URL
#   ...@ep-cool-bread-ayr2pvtz.c-5.us-east-2...          → DIRECT_URL
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-bread-ayr2pvtz-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-cool-bread-ayr2pvtz.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Email (optional for local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ethiopian-menu.com

# Payment (mock mode for local dev)
USE_MOCK_PAYMENT=true
PAYMENT_PROVIDER=mock

# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_BASE_URL=https://app.ethiotelecom.et

# CBE Birr
CBE_BIRR_API_KEY=
CBE_BIRR_MERCHANT_ID=
CBE_BIRR_BASE_URL=https://api.cbebirr.com

# Chapa
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
